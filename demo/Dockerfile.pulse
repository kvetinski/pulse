# syntax=docker/dockerfile:1

FROM rust:1.88.0-bookworm AS builder
WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        libprotobuf-dev \
        build-essential \
        cmake \
        pkg-config \
        libcurl4-openssl-dev \
        libssl-dev \
        libsasl2-dev \
        zlib1g-dev \
        libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY demo/grpc-target/proto/demo.proto ./demo/proto/demo.proto

RUN cargo build --locked --release --bin pulse \
    && mkdir -p /build/descriptors \
    && protoc \
        -I /build/demo/proto \
        --include_imports \
        --descriptor_set_out=/build/descriptors/demo.pb \
        /build/demo/proto/demo.proto

FROM debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 pulse \
    && useradd --system --uid 10001 --gid 10001 --no-create-home pulse

COPY --from=builder /build/target/release/pulse /usr/local/bin/pulse
COPY --from=builder /build/descriptors/demo.pb /app/descriptors/demo.pb
COPY demo/scenarios.yaml /app/scenarios.yaml
COPY k8s/overlays/kind/scenarios.kind.yaml /app/scenarios.kind.yaml

RUN chown -R 10001:10001 /app

USER 10001:10001
EXPOSE 9090
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/pulse"]
